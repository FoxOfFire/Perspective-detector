#version 450
#extension GL_NV_mesh_shader : require

const uint GROUP_SIZE = 12;
const uint PRIMITIVE_COUNT = 12;

// Set the number of threads per workgroup (always one-dimensional).
layout(local_size_x=GROUP_SIZE) in; 

// maximum allocation size for each meshlet
// (note that max_primitives defines the max primitives for the thread group)
layout(max_vertices=PRIMITIVE_COUNT*3, max_primitives=PRIMITIVE_COUNT) out;

// the primitive type (points,lines or triangles)
layout(triangles) out;

out vec4 ms_out_col[];
out vec4 ms_out_task_col[];
out vec3 ms_out_norm[];
out vec2 ms_out_tex[];

uniform float scale = 1.0;

// External parameters of the shader
uniform mat4 world;
uniform mat4 worldIT;
uniform mat4 viewProj;

struct Vertex {
    vec3 pos;
    vec3 norm;
    vec2 tex;
};

layout (std430, binding = 1) buffer VertexBuffer {
    Vertex vertices[];
};

layout (std430, binding = 2) buffer IndexBuffer {
    uint indices[];
};

const uint INSTANCE_COUNT = 32;

taskNV in instanceData {
	uint taskGroupID[INSTANCE_COUNT];
	mat4 meshWorlds[INSTANCE_COUNT];
} iData;

const uint NUMBER_OF_COLORS = 10;

const vec3 colors[NUMBER_OF_COLORS] = {
    vec3(1.0, 0.0, 0.0),   
    vec3(0.0, 1.0, 0.0),   
    vec3(0.0, 0.0, 1.0),   
    vec3(1.0, 1.0, 0.0),   
    vec3(1.0, 0.0, 1.0),   
    vec3(0.0, 1.0, 1.0),   
    vec3(1.0, 0.5, 0.0),   
    vec3(0.5, 0.0, 1.0),   
    vec3(0.0, 0.5, 0.2),   
    vec3(0.8, 0.8, 0.8)    
};

out vec4 meshletColor[];

uniform uint triangleCount;

void main()
{
    uint meshNo = 1;
    // Get thread id
    uint thread_id = gl_LocalInvocationID.x;
    // Get group id
    uint group_id = gl_WorkGroupID.x;
    // Get global id
    // {globa id} = {group_id} * {group size} + thread_id
    uint global_id = gl_GlobalInvocationID.x;

    // Stop excess triangle draws
    if (thread_id >= triangleCount) return;

    if (group_id >= meshNo) return;
    // We are drawing out only one triangle for now
    gl_PrimitiveCountNV = PRIMITIVE_COUNT;

    // calculate vertex indices
    uvec3 ids = uvec3(0,1,2) + uvec3(thread_id * 3);
    uvec3 indx = uvec3(indices[ids.x], indices[ids.y], indices[ids.z]);

    gl_PrimitiveIndicesNV[ids.x] = ids.x;
    gl_PrimitiveIndicesNV[ids.y] = ids.y;
    gl_PrimitiveIndicesNV[ids.z] = ids.z;

    mat4 worldTransform = iData.meshWorlds[group_id];
    mat4 worldTransformIT = transpose(inverse(worldTransform));

    // Set position of vertex, indice and color
    // corresponding to thread_id
    //gl_MeshVerticesNV[ids.x].gl_Position = viewProj * worldTransform * vec4(vertices[indx.x].pos * scale, 1.0);
    //gl_MeshVerticesNV[ids.y].gl_Position = viewProj * worldTransform * vec4(vertices[indx.y].pos * scale, 1.0);
    //gl_MeshVerticesNV[ids.z].gl_Position = viewProj * worldTransform * vec4(vertices[indx.z].pos * scale, 1.0);
    gl_MeshVerticesNV[ids.x].gl_Position = vec4(vertices[indx.x].pos*scale, 1.0);
    gl_MeshVerticesNV[ids.y].gl_Position = vec4(vertices[indx.y].pos*scale, 1.0);
    gl_MeshVerticesNV[ids.z].gl_Position = vec4(vertices[indx.z].pos*scale, 1.0);



    ms_out_col[ids.x] = vec4(colors[group_id % NUMBER_OF_COLORS], 1.0);
    ms_out_col[ids.y] = vec4(colors[group_id % NUMBER_OF_COLORS], 1.0);
    ms_out_col[ids.z] = vec4(colors[group_id % NUMBER_OF_COLORS], 1.0);
    
    ms_out_task_col[ids.x] = vec4(colors[iData.taskGroupID[group_id] % NUMBER_OF_COLORS], 1.0);
    ms_out_task_col[ids.y] = vec4(colors[iData.taskGroupID[group_id] % NUMBER_OF_COLORS], 1.0);
    ms_out_task_col[ids.z] = vec4(colors[iData.taskGroupID[group_id] % NUMBER_OF_COLORS], 1.0);
    
    ms_out_tex[ids.x] = vertices[indx.x].tex;
    ms_out_tex[ids.y] = vertices[indx.y].tex;
    ms_out_tex[ids.z] = vertices[indx.z].tex;
    
    ms_out_norm[ids.x] = (worldTransformIT * vec4(vertices[indx.x].norm,0)).xyz;
    ms_out_norm[ids.y] = (worldTransformIT * vec4(vertices[indx.y].norm,0)).xyz;
    ms_out_norm[ids.z] = (worldTransformIT * vec4(vertices[indx.z].norm,0)).xyz;
}
